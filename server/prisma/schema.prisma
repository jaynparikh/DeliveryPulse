generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  AT_RISK
  WATCH
  HEALTHY
}

enum RiskSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum RiskStatus {
  OPEN
  MONITORING
  MITIGATED
}

enum ResourceStatus {
  AVAILABLE
  ALLOCATED
  OVERLOADED
}

model Project {
  id         Int           @id @default(autoincrement())
  name       String        @unique
  client     String
  owner      String
  progress   Int
  status     ProjectStatus
  target     String
  risk       String

  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model Risk {
  id          Int          @id @default(autoincrement())
  title       String
  project     String
  severity    RiskSeverity
  status      RiskStatus
  owner       String
  description String
  action      String

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Resource {
  id          Int            @id @default(autoincrement())
  name        String         @unique
  role        String
  project     String
  allocation  Int
  capacity    Int
  status      ResourceStatus

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}